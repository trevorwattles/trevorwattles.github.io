---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Intro from "../components/Intro.astro";
import ProjectRow from "../components/ProjectRow.astro";
import Experience from "../components/Experience.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import { SHOW_OTHER_PROJECTS } from "../config";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const others = SHOW_OTHER_PROJECTS
  ? (await getCollection("other")).sort((a, b) => a.data.order - b.data.order)
  : [];
---

<Base>
  <Nav />
  <main>
    <Intro />

    <section id="work" class="section wrap" aria-labelledby="work-heading">
      <div class="work-head">
        <h2 id="work-heading">Selected work</h2>
        <p class="label">{projects.length} projects</p>
      </div>
      {projects.map((project, index) => (
        <ProjectRow project={project} index={index} />
      ))}
      {others.length > 0 && (
        <div class="others">
          <h3 class="label">Other projects</h3>
          <ul>
            {others.map((o) => (
              <li>
                {o.data.link ? (
                  <a href={o.data.link}>{o.data.title}</a>
                ) : (
                  o.data.title
                )}{" "}
                — {o.data.oneLiner}
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <Experience />
    <About />
  </main>
  <Footer />
  <Lightbox />
</Base>

<style>
  /* The section heading sits on its own line with a hairline under it,
     so it reads as the header for the whole list, not part of project 1. */
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--rule);
  }

  .others {
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .others ul {
    margin-top: var(--space-3);
    padding-left: 1.1em;
  }
</style>
