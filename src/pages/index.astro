---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Intro from "../components/Intro.astro";
import ProjectRow from "../components/ProjectRow.astro";
import Experience from "../components/Experience.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import { SHOW_OTHER_PROJECTS } from "../config";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const others = SHOW_OTHER_PROJECTS
  ? (await getCollection("other")).sort((a, b) => a.data.order - b.data.order)
  : [];
---

<Base>
  <Nav />
  <main>
    <Intro />

    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading">Selected work</h2>
      {projects.map((project, index) => (
        <ProjectRow project={project} index={index} />
      ))}
      {others.length > 0 && (
        <ul>
          {others.map((o) => (
            <li>
              {o.data.link ? (
                <a href={o.data.link}>{o.data.title}</a>
              ) : (
                o.data.title
              )}{" "}
              — {o.data.oneLiner}
            </li>
          ))}
        </ul>
      )}
    </section>

    <Experience />
    <About />
  </main>
  <Footer />
  <Lightbox />
</Base>
